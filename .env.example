# =============================================================================
# VFIB Marketing OS V0.1 —— 环境变量样例
# -----------------------------------------------------------------------------
# 用法：复制为 .env（或直接在进程环境中注入；本进程不自动读取 .env 文件，
#       请由 systemd / pm2 / Docker 的 env_file 注入）。
# **本文件只列变量名，不放任何可用凭据。**
#
# 优先级：内置默认 < config.json < 环境变量（本文件）。
# ⚠ 未接通的集成必须保持 mock / none，不得为了让界面「看起来完整」而改成 real。
#    集成状态的唯一权威来源是 lib/mos/config.js 的 integrations 矩阵。
# =============================================================================

# ---------- 服务监听与数据目录 ----------
MOS_PORT=9080
MOS_HOST=127.0.0.1
# 数据目录（相对路径按工程根解析）；业务库为 <MOS_DATA_DIR>/mos.json
MOS_DATA_DIR=data
# 是否放行本机回环地址（本地开发 true；生产配合白名单收紧）
MOS_ALLOW_LOCALHOST=1

# ---------- 首次初始化口令（仅在库为空时生效，落盘后不再读取） ----------
# 引导管理员（mosadmin）的口令。留空则随机生成并在首次启动时打印一次。
# 请勿把真实口令写进仓库。
MOS_ADMIN_PASSWORD=
# DEMO 演示账号的共享口令；仅在 demoSeed=true 时生效。留空则随机生成。
MOS_DEMO_PASSWORD=

# ---------- 网络安全 ----------
# 可信反代（配置后才会信任 X-Forwarded-*）。留空 = 忽略全部转发头（最安全）
MOS_TRUSTED_PROXIES=
# 客户端 CIDR 白名单（留空 = 不限制，生产建议配置）
MOS_ALLOWED_CLIENT_CIDRS=
# Cookie Secure 策略：auto | always | never
MOS_SECURE_COOKIES=auto
# 允许的跨源来源（CSRF Origin 校验）
MOS_ALLOWED_ORIGINS=

# ---------- 子系统开关 ----------
# 是否写入 DEMO 种子数据（演示身份与示例业务数据；生产请置 0）
MOS_DEMO_SEED=1

# ---------- 集成状态（唯一权威来源，改动必须同步更新 docs/MOCK_REAL_MATRIX.md） ----------
# identity / knowledge / library：真实系统尚未审计接通 → 必须保持 mock
MOS_IDENTITY=mock
MOS_KNOWLEDGE=mock
MOS_LIBRARY=mock
# 外部情报采集：真实 HTTP 抓取（受下方 allowlist + SSRF 拦截约束）
MOS_SOURCE_INGEST=real
# 模型 Provider：none = 明确未配置（none | mock | deepseek / openai）
MOS_TEXT_PROVIDER=none
MOS_IMAGE_PROVIDER=none

# ---------- 文本/图像 Provider 服务端参数（A-05） ----------
# ⚠ 密钥只在服务端（或 config.json mos.text/image），绝不下发浏览器、绝不写日志/导出物。
# 未配置密钥 → 保持 NOT_CONFIGURED（不发起任何出站、不伪造输出）。
MOS_TEXT_API_KEY=
# baseUrl/model/timeout 可配（自托管网关、代理、离线契约测试均需要）
MOS_TEXT_BASE_URL=
MOS_TEXT_MODEL=
MOS_TEXT_TIMEOUT_MS=30000
MOS_IMAGE_API_KEY=
MOS_IMAGE_BASE_URL=
MOS_IMAGE_MODEL=
MOS_IMAGE_TIMEOUT_MS=60000
# 真实端到端联调开关（默认关闭）。仅当另行提供 MOS_REAL_TEXT_API_KEY / MOS_REAL_IMAGE_API_KEY 时生效。
# 未开启时 provider 契约自检按 **BLOCKED（无凭据）** 如实记录，不假称已验证。
MOS_PROVIDER_LIVE=0
MOS_REAL_TEXT_API_KEY=
MOS_REAL_IMAGE_API_KEY=

# ---------- Enterprise Workspace（企业资料库）集成（A-06） ----------
# 默认关闭 → fail closed（不发起任何出站、不返回任何资产结果）。
# 凭据（Ed25519 私钥）只在服务端；baseUrl 只应由运维配置（不接受用户输入）。
MOS_WORKSPACE_ENABLED=0
MOS_WORKSPACE_BASE_URL=
MOS_WORKSPACE_KEY_ID=
# 二选一：直接给 PEM，或给私钥文件路径（该路径优先于 PEM 为空时）
MOS_WORKSPACE_PRIVATE_KEY_PEM=
MOS_WORKSPACE_PRIVATE_KEY_PATH=
# 当前服务票据（由 Workspace 签发；服务票据**永不含** admission.final.decision）
MOS_WORKSPACE_TICKET=
MOS_WORKSPACE_TIMEOUT_MS=15000

# ---------- 轻量情报采集调度（A-01） ----------
# 默认关闭；开启后仅调度 ACTIVE + 非 MANUAL 频率 + 域名在出站白名单内的来源。
MOS_SCHEDULER_ENABLED=0
MOS_SCHEDULER_INTERVAL_MINUTES=60
MOS_SCHEDULER_MAX_PER_TICK=3
MOS_SCHEDULER_MAX_FAILURES=5

# ---------- 出站抓取策略（SSRF 防御） ----------
# allowlist（逗号分隔）。留空 = 拒绝一切真实出站（fail closed）。
# 内置默认：www.bis.org,bis.org,www.imf.org,imf.org,www.fsb.org,fsb.org,
#          www.fatf-gafi.org,fatf-gafi.org,www.swift.com,swift.com
MOS_EGRESS_ALLOWED_HOSTS=

# 允许的出站端口（逗号分隔）。生产默认仅 443。
# 说明：出站连接会被**固定绑定到已校验的 IP**（关闭 DNS 重绑定面），
#       跳转链逐跳重新校验，且不读取 HTTP_PROXY/HTTPS_PROXY。
MOS_EGRESS_ALLOWED_PORTS=443

# 跳转链最大跳数（0-10）。每一跳都重新执行白名单/SSRF/协议/端口校验。
MOS_EGRESS_MAX_REDIRECTS=3

# 生产模式判定：MOS_PRODUCTION=1 或 NODE_ENV=production。
# 生产模式下，下列两个测试专用开关**一律失效**（回环与明文 http 始终拒绝）。
MOS_PRODUCTION=0

# ⚠ 以下两项仅用于本机端到端验证，生产必须保持关闭（默认即关闭）
# 允许明文 http 出站
MOS_EGRESS_ALLOW_HTTP=0
# 允许抓取回环地址（127.0.0.0/8）
MOS_EGRESS_ALLOW_LOOPBACK=0
